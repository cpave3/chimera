{
  "_comment": "Partial override example. Drop into ~/.chimera/theme.json. Keys starting with _ are notes. Tokens you leave out keep the default theme's colour. A value is an ANSI colour name (red, brightBlack, ...), default (the terminal's own foreground), or #rrggbb.",
  "accent": "brightGreen",
  "info": "brightCyan",
  "error": "brightRed",
  "muted": "brightBlack",
  "keyword": "brightMagenta",
  "comment": "brightBlack"
}
